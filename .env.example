# Copie este ficheiro para .env (uso local) e preencha.
# Na Cloudflare, defina os mesmos valores como variáveis encriptadas. Nunca os coloque no Git.

# Senha do painel: mínimo 12 caracteres; recomendam-se 20 aleatórios.
ADMIN_PASSWORD=

# Assina as sessões. Texto aleatório longo. Mudá-lo termina todas as sessões.
SESSION_SECRET=

# Opcional: cópias automáticas. Mínimo 24 caracteres. Só permite ler cópias.
BACKUP_TOKEN=

# Só para o servidor local (server/local.mjs)
PORT=8788
HOST=127.0.0.1
DB_PATH=data/convite.db
# Use 1 apenas atrás de um proxy reverso de confiança (nginx, Caddy).
TRUST_PROXY=0
